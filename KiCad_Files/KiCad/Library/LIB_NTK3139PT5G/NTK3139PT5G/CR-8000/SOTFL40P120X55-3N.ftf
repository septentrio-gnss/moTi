           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -63200 40000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -63200 40000)
                  (angle 90)
                  (padstackGroup default (padstack r46.5_40))
                )
              )
            )
          )
          (pin 2
            (pt -63200 -40000)
