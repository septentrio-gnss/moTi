            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -5000 60000
                        (width 20000)
                      )
                      (pt 5000 60000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 5000 60000
                        (width 20000)
                      )
                      (pt 5000 -60000
                        (width 20000)
                      )
                    )
                  )
