(version 1)

# prevent silk over tented vias
(rule silk_over_via
   (constraint silk_clearance (min 0.2mm))
   (condition "A.Type == '*Text' && B.Type == 'Via'"))

(rule "Distance between Vias of Different Nets"
    (constraint hole_to_hole (min 0.254mm))
    (condition "A.Type == 'Via' && B.Type == 'Via' && A.Net != B.Net"))

(rule "skew matching USB"
	(constraint skew (min 0mm) (max 0.1mm))
	(condition "A.netname == 'D+' && AB.isCoupledDiffPair()"))

(rule "diff pair max uncoupled lenght"
	(constraint diff_pair_uncoupled (max 5mm)))
